{
  "name": "starter-blog",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "next dev",
    "dev": "contentlayer2 build && INIT_CWD=$PWD next dev",
    "build": "contentlayer2 build && INIT_CWD=$PWD next build && cross-env NODE_OPTIONS='--experimental-json-modules' node -r esbuild-register ./scripts/postbuild.mjs",
    "serve": "next start",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "content": "contentlayer2 dev",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "biome lint --write ."
  },
  "dependencies": {
    "@next/bundle-analyzer": "^15.5.23",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.7",
    "autoprefixer": "^10.4.13",
    "contentlayer2": "^0.5.0",
    "esbuild": "^0.25.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.2",
    "mdx-bundler": "^10.1.1",
    "next": "^15.5.23",
    "next-contentlayer2": "^0.5.0",
    "next-themes": "^0.2.0",
    "pliny": "^0.4.1",
    "postcss": "^8.5.6",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.0.0",
    "rehype-citation": "^2.0.0",
    "rehype-katex": "^7.0.0",
    "rehype-preset-minify": "^7.0.0",
    "rehype-prism-plus": "^2.0.0",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwindcss": "^3.4.19",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@svgr/webpack": "^8.1.0",
    "@types/react": "^18.0.18",
    "cross-env": "^7.0.3",
    "esbuild-register": "^3.6.0",
    "husky": "^8.0.0",
    "lint-staged": "^17.3.0",
    "typescript": "^5.3.0"
  },
  "resolutions": {
    "esbuild": "^0.25.0",
    "pliny/js-yaml": "^4.3.1",
    "sharp": "^0.35.0",
    "postcss": "^8.5.26",
    "uuid": "^11.1.1",
    "@opentelemetry/propagator-jaeger": "^2.9.0"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": ["biome check --write --no-errors-on-unmatched"]
  },
  "browserslist": ["> 0.5%", "last 2 versions", "not dead", "not ie 11"]
}
